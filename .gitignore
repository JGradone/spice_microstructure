# Local config with machine specific paths
config/config.yaml

# Local-only records (e.g. unfiltered personal shell history)
docs/private/

# Data never go in git: raw, patched and converted instrument files
*.P
*.p
*.nc
*.mat
*.h5
*.hdf5
*.zarr/
data/
derived/

# Pipeline outputs live in outputs/<run.name>/ inside this repository.
# Figures, cast tables, reports and step metadata are small and may be
# committed; bulky or machine-generated working files stay local.
# patched .p copies and links to raw files
outputs/*/patch/*/
# ...but keep the edit specs passed to patch-config
!outputs/*/patch/edits/
# perturb working trees (NetCDF, per-cast logs, caches)
outputs/*/convert/*/
# full CLI transcripts; regenerated on every run
outputs/**/commands.log

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# OS and editor clutter
.DS_Store
Thumbs.db
.vscode/
.idea/
# QC explorer data (embedded in qc_explorer.html)
outputs/**/qc_explorer_data.json
